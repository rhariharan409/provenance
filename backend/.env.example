ENV=development
DATABASE_URL=postgresql+psycopg://provenance:provenance@localhost:5432/provenance
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/github/callback
SESSION_SECRET=
FRONTEND_URL=http://localhost:3000
ADMIN_GITHUB_USERNAMES=

# Section 2 settings
GITHUB_API_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem
REPO_STORAGE_PATH=./data/repos
MAX_REPO_SIZE_MB=500
MAX_COMMITS=20000
MAX_PULL_REQUESTS=300
CLONE_TIMEOUT_SECONDS=600
MAX_PROJECTS_PER_USER=20

# Section 3 settings
SCORE_WEIGHT_SURVIVAL=0.40
SCORE_WEIGHT_EFFECTIVE_CHANGE=0.25
SCORE_WEIGHT_OWNERSHIP=0.15
SCORE_WEIGHT_COLLABORATION=0.20
MAX_BLAME_FILES=1500
MAX_FILE_SIZE_KB=400
ANALYSIS_TIMEOUT_SECONDS=900
BULK_COMMIT_LINE_CAP=1500

# Section 4 settings
PASSPORT_SIGNING_SECRET=
PUBLIC_BASE_URL=http://localhost:3000
MAX_DISPUTE_TEXT=1000
MAX_OPEN_DISPUTES_PER_USER=5

# Section 5 settings
ANTHROPIC_API_KEY=
SUMMARY_MODEL=claude-sonnet-4-5
SUMMARY_MAX_TOKENS=600
ORIGINALITY_MIN_SHARED_LINES=40
ORIGINALITY_KGRAM=8
ORIGINALITY_WINDOW=4




